{
  "name": "pii-safe",
  "version": "0.1.2",
  "description": "Local-first PII redaction for LLM prompts, logs, and Node.js apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "pii",
    "pii-redaction",
    "pii-detection",
    "pii-sanitization",
    "redact",
    "redaction",
    "sanitization",
    "sanitize",
    "data-redaction",
    "data-privacy",
    "privacy",
    "privacy-tools",
    "privacy-engineering",
    "sensitive-data",
    "secrets",
    "secret-scanning",
    "token-redaction",
    "masking",
    "tokenization",
    "llm",
    "ai",
    "generative-ai",
    "prompt",
    "prompt-safety",
    "prompt-sanitization",
    "openai",
    "anthropic",
    "logging",
    "safe-logging",
    "log-redaction",
    "pino",
    "winston",
    "typescript",
    "node",
    "nodejs",
    "security",
    "compliance",
    "gdpr",
    "hipaa",
    "email",
    "phone",
    "credit-card",
    "luhn",
    "jwt",
    "api-key",
    "nigeria",
    "bvn",
    "nin",
    "local-first",
    "deterministic"
  ],
  "homepage": "https://github.com/Osamor-Chukwuka/pii-safe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Osamor-Chukwuka/pii-safe.git"
  },
  "bugs": {
    "url": "https://github.com/Osamor-Chukwuka/pii-safe/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "peerDependencies": {
    "pino": ">=8",
    "winston": ">=3"
  },
  "peerDependenciesMeta": {
    "pino": {
      "optional": true
    },
    "winston": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
